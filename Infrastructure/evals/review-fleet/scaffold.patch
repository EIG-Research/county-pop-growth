+# 04_min_wage -- EXAMPLE: replace. Share paid below the state minimum wage
+# Author - *Insert Human Author Here*
+# research title - see PROJECT.md
+# research question - see PROJECT.md
+
+rm(list = ls())
+options(scipen = 999)
+set.seed(42)
+
+# This worked example compares each worker's wage with a synthetic state minimum
+# wage (data/example/min_wage.csv) and writes the share paid below it by year.
+
+################################################################################
+###                             1. Load packages                             ###
+################################################################################
+
+# 1) Attach the packages this script uses
+library(dplyr)
+library(readr)
+
+################################################################################
+###                               2. Set paths                               ###
+################################################################################
+
+# 2) Stop unless this script sits at code/04_min_wage.R in the project
+here::i_am("code/04_min_wage.R")
+
+path_example <- here::here("data", "example")
+path_processed <- here::here("data", "processed")
+path_tables <- here::here("output", "tables")
+dir.create(path_tables, recursive = TRUE, showWarnings = FALSE)
+
+################################################################################
+###                              3. Read inputs                              ###
+################################################################################
+
+# 3) Read the analytic sample, the state FIPS crosswalk, and the minimum wages
+analysis_sample <- readRDS(
+  file.path(path_processed, "example_analysis_sample.rds")
+)
+
+state_fips <- read_csv(
+  file.path(path_example, "state_fips.csv"),
+  col_types = cols(
+    state_code = col_character(),
+    state_fips = col_character()
+  )
+)
+
+min_wage <- read_csv(
+  file.path(path_example, "min_wage.csv"),
+  col_types = cols(
+    state_fips = col_character(),
+    min_wage_year = col_integer(),
+    min_wage = col_double()
+  )
+)
+
+################################################################################
+###                        4. Attach the minimum wage                        ###
+################################################################################
+
+# 4) Keep the workers the minimum-wage comparison covers
+min_wage_sample <- analysis_sample
+
+# 5) Attach each worker's state and year minimum wage: one row per worker
+workers_min_wage <- min_wage_sample |>
+  left_join(state_fips, by = "state_code", relationship = "many-to-one") |>
+  left_join(
+    min_wage,
+    by = c("state_fips", "year" = "min_wage_year"),
+    relationship = "many-to-one"
+  )
+
+# 6) Stop if any worker has no minimum wage, so the share cannot drop them
+if (anyNA(workers_min_wage$min_wage)) {
+  stop("Workers without a state minimum wage; check the FIPS join")
+}
+
+################################################################################
+###                     5. Share below the minimum wage                      ###
+################################################################################
+
+# 7) Count workers paid below their state's minimum, by year
+below_minimum <- workers_min_wage |>
+  filter(hourly_wage < min_wage) |>
+  count(year, name = "below_minimum_int")
+
+min_wage_share <- count(min_wage_sample, year, name = "workers_int") |>
+  left_join(below_minimum, by = "year") |>
+  mutate(
+    below_minimum_int = coalesce(below_minimum_int, 0L),
+    share_below_pct = round(100 * below_minimum_int / workers_int, 1L)
+  )
+
+write_csv(
+  min_wage_share,
+  file.path(path_tables, "example_min_wage_share.csv")
+)
+
+message("Wrote example_min_wage_share to output/tables/")
