+# 06_policy_panel -- EXAMPLE: replace. A state wage policy adopted in different years
+# Author - *Insert Human Author Here*
+# research title - see PROJECT.md
+# research question - see PROJECT.md
+
+rm(list = ls())
+options(scipen = 999)
+set.seed(42)
+
+# This worked example builds a synthetic state-year panel, seeded so every run is
+# identical, and estimates the effect of a wage policy that states adopted in
+# different years.
+
+################################################################################
+###                             1. Load packages                             ###
+################################################################################
+
+# 1) Attach the packages this script uses
+library(dplyr)
+library(readr)
+library(fixest)
+
+################################################################################
+###                               2. Set paths                               ###
+################################################################################
+
+# 2) Stop unless this script sits at code/06_policy_panel.R in the project
+here::i_am("code/06_policy_panel.R")
+
+path_tables <- here::here("output", "tables")
+dir.create(path_tables, recursive = TRUE, showWarnings = FALSE)
+
+################################################################################
+###                            3. Build the panel                            ###
+################################################################################
+
+# 3) The year each treated state adopted the policy; other states never do
+adoption_year <- c(
+  S02 = 2017L, S05 = 2017L, S07 = 2018L, S10 = 2019L,
+  S12 = 2019L, S15 = 2020L, S17 = 2021L, S19 = 2021L
+)
+
+# 4) One row per state and year; the effect grows with years since adoption
+set.seed(20260929)
+policy_panel <- expand.grid(
+  state_code = sprintf("S%02d", 1:20),
+  year = 2015:2023,
+  stringsAsFactors = FALSE
+) |>
+  mutate(
+    adoption_year = coalesce(unname(adoption_year[state_code]), 10000L),
+    treated = year >= adoption_year,
+    log_wage = 2.8 + 0.01 * (year - 2015L) +
+      if_else(treated, 0.015 * (year - adoption_year + 1L), 0) +
+      rnorm(n(), mean = 0, sd = 0.02)
+  )
+
+################################################################################
+###                          4. Estimate the effect                          ###
+################################################################################
+
+# 5) Estimate by adoption cohort (Sun and Abraham 2021) and aggregate to one
+#    average effect on the treated, with standard errors clustered by state
+policy_model <- feols(
+  log_wage ~ sunab(adoption_year, year) | state_code + year,
+  data = policy_panel,
+  vcov = ~state_code
+)
+policy_att <- summary(policy_model, agg = "ATT")
+
+policy_estimate <- data.frame(
+  term = "ATT",
+  estimate = round(unname(coef(policy_att)[["ATT"]]), 4L),
+  std_error = round(unname(se(policy_att)[["ATT"]]), 4L),
+  treated_states_int = length(adoption_year),
+  observations_int = nobs(policy_model)
+)
+
+write_csv(
+  policy_estimate,
+  file.path(path_tables, "example_policy_estimate.csv")
+)
+
+message("Wrote example_policy_estimate to output/tables/")
