+# 05_households -- EXAMPLE: replace. Mean household income by region
+# Author - *Insert Human Author Here*
+# research title - see PROJECT.md
+# research question - see PROJECT.md
+
+rm(list = ls())
+options(scipen = 999)
+set.seed(42)
+
+# This worked example summarizes the synthetic household file,
+# data/example/households.csv, by region.
+
+################################################################################
+###                             1. Load packages                             ###
+################################################################################
+
+# 1) Attach the packages this script uses
+library(dplyr)
+library(readr)
+
+################################################################################
+###                               2. Set paths                               ###
+################################################################################
+
+# 2) Stop unless this script sits at code/05_households.R in the project
+here::i_am("code/05_households.R")
+
+path_example <- here::here("data", "example")
+path_tables <- here::here("output", "tables")
+dir.create(path_tables, recursive = TRUE, showWarnings = FALSE)
+
+################################################################################
+###                              3. Read inputs                              ###
+################################################################################
+
+# 3) Read the households and the state regions with explicit column types
+households <- read_csv(
+  file.path(path_example, "households.csv"),
+  col_types = cols(
+    household_id = col_integer(),
+    state_code = col_character(),
+    year = col_integer(),
+    household_income = col_double(),
+    household_weight = col_double(),
+    person_weight = col_double()
+  )
+)
+
+states <- read_csv(
+  file.path(path_example, "states.csv"),
+  col_types = cols(
+    state_code = col_character(),
+    region = col_character()
+  )
+)
+
+################################################################################
+###                           4. Income by region                            ###
+################################################################################
+
+# 4) Mean household income by region, weighted to the population
+income_by_region <- households |>
+  inner_join(
+    states,
+    by = "state_code",
+    relationship = "many-to-one",
+    unmatched = "error"
+  ) |>
+  group_by(region) |>
+  summarise(
+    households_int = n(),
+    mean_household_income = round(
+      weighted.mean(household_income, household_weight), -2L
+    ),
+    .groups = "drop"
+  )
+
+write_csv(
+  income_by_region,
+  file.path(path_tables, "example_household_income_by_region.csv")
+)
+
+message("Wrote example_household_income_by_region to output/tables/")
