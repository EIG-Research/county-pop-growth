*! EIG graph scheme. Auto-generated by scripts/sync_tokens.py. Do not edit manually.
*! Source: tokens/eig-style-tokens.v1.json
*! Version: 2.0.0
*  Colors are RGB triples of token values; fonts are set by eig_theme.do.

#include s2color

graphsize x 6.5
graphsize y 3.5

color background       "255 255 255"
color foreground       "0 0 0"
color graphregion      "255 255 255"
color graphregion_line "255 255 255"
color plotregion       "255 255 255"
color plotregion_line  "255 255 255"
color legend           "255 255 255"
color legend_line      "255 255 255"
color text             "0 0 0"
color body             "0 0 0"
color heading          "0 0 0"
color subheading       "0 0 0"
color axis_title       "0 0 0"
color label            "0 0 0"
color key_label        "0 0 0"
color tick_label       "0 0 0"
color small_body       "68 68 68"
color axisline         "207 207 207"
color tick             "207 207 207"
color grid             "217 217 217"
color major_grid       "217 217 217"
color minor_grid       "217 217 217"

* Series colors, in colors.discrete_order
color p1 "2 65 64"
color p2 "25 79 139"
color p3 "94 156 134"
color p4 "225 173 40"
color p5 "57 39 79"
color p6 "23 111 150"
color p7 "214 147 111"

* Horizontal gridlines only
yesno draw_major_hgrid yes
yesno draw_major_vgrid no
