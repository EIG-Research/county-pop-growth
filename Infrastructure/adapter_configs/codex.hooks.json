{
  "description": "Canonical-source guard, brain-sync reminder, and session recovery for Codex. Canonical source for .codex/hooks.json -- edit here, then run 'make brain-sync'.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Bash|apply_patch|Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/Infrastructure/scripts/hooks/run_python.sh\" \"$(git rev-parse --show-toplevel)/Infrastructure/scripts/hooks/guard_generated_tree.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$payload = [Console]::In.ReadToEnd(); $root = git rev-parse --show-toplevel; $payload | py -3 (Join-Path $root 'Infrastructure/scripts/hooks/guard_generated_tree.py')\"",
            "timeout": 10,
            "statusMessage": "Checking canonical-source governance"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:Bash|apply_patch|Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/Infrastructure/scripts/hooks/run_python.sh\" \"$(git rev-parse --show-toplevel)/Infrastructure/scripts/hooks/remind_brain_sync.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$payload = [Console]::In.ReadToEnd(); $root = git rev-parse --show-toplevel; $payload | py -3 (Join-Path $root 'Infrastructure/scripts/hooks/remind_brain_sync.py')\"",
            "timeout": 10,
            "statusMessage": "Checking canonical-source synchronization"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(?:startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/Infrastructure/scripts/hooks/run_python.sh\" \"$(git rev-parse --show-toplevel)/Infrastructure/scripts/hooks/session_context.py\"",
            "commandWindows": "powershell -NoProfile -Command \"$payload = [Console]::In.ReadToEnd(); $root = git rev-parse --show-toplevel; $payload | py -3 (Join-Path $root 'Infrastructure/scripts/hooks/session_context.py')\"",
            "timeout": 15,
            "statusMessage": "Loading repository recovery context",
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
