{
  "permissions": {
    "allow": [
      "Bash(make brain-sync)",
      "Bash(make brain-check)",
      "Bash(make parity-check)",
      "Bash(make literature-check)",
      "Bash(make dataset-registry-check)",
      "Bash(make style-tokens-check)",
      "Bash(make maintenance-check)",
      "Bash(python3 Infrastructure/scripts/check_internal_path_references.py *)",
      "Bash(python3 Infrastructure/scripts/check_catalog_staleness.py *)",
      "Bash(python3 Infrastructure/scripts/check_style_token_drift.py *)",
      "Bash(python3 Infrastructure/scripts/validate_literature_catalog.py *)",
      "Bash(python3 Infrastructure/scripts/validate_dataset_registry.py *)",
      "Bash(python3 Infrastructure/scripts/validate_replication_manifest.py *)",
      "Bash(python3 Infrastructure/scripts/test_hooks.py *)",
      "Bash(python3 Infrastructure/scripts/test_brain.py *)",
      "Bash(python3 Infrastructure/scripts/test_review_board.py *)",
      "Bash(python3 Infrastructure/scripts/test_war_room.py *)",
      "Bash(python3 Infrastructure/scripts/test_replication.py *)",
      "Bash(python3 Infrastructure/scripts/test_review_fleet.py *)",
      "Bash(python3 Infrastructure/scripts/test_review_eval.py *)",
      "Bash(python3 Infrastructure/scripts/test_path_references.py *)",
      "Bash(python3 Infrastructure/scripts/review_board.py status *)",
      "Bash(python3 Infrastructure/scripts/review_board.py lint *)",
      "Bash(python3 Infrastructure/scripts/review_board.py summary *)",
      "Bash(python3 Infrastructure/scripts/brain.py check)",
      "Bash(python3 Infrastructure/scripts/brain.py check *)",
      "Bash(python3 Infrastructure/scripts/brain.py sync)",
      "Bash(python3 Infrastructure/scripts/run_maintenance_checks.py)",
      "Bash(python3 Infrastructure/style/scripts/sync_tokens.py)",
      "Bash(python3 Infrastructure/style/scripts/sync_tokens.py --check)",
      "Bash(python3 Infrastructure/style/scripts/compliance/check_datawrapper_manifest.py *)",
      "Bash(python3 Infrastructure/style/scripts/compliance/check_legacy_metadata.py *)",
      "Bash(python3 Infrastructure/style/scripts/fonts/check-fonts.py *)",
      "Bash(python3 Infrastructure/scripts/run_maintenance_checks.py *)",
      "Bash(make style-test)",
      "Bash(make localapp-test)",
      "Bash(Rscript code/*)",
      "Bash(python3 code/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git ls-files *)"
    ],
    "ask": [
      "Bash(git *--output*)",
      "Bash(git difftool*)",
      "Bash(Rscript code/*..*)",
      "Bash(python3 code/*..*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push +*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Edit(data/raw/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/Infrastructure/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/Infrastructure/scripts/hooks/guard_generated_tree.py\"",
            "timeout": 10,
            "statusMessage": "Checking canonical-source governance"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/Infrastructure/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/Infrastructure/scripts/hooks/remind_brain_sync.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/Infrastructure/scripts/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/Infrastructure/scripts/hooks/session_context.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
