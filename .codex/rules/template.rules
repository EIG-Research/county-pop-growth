# Project-local Codex execution policy (Starlark), generated from
# Infrastructure/adapter_configs/permissions.yaml by `make brain-sync`; do not edit.
#
# Codex execpolicy is experimental, and it loads only for a trusted project.
# This file holds `prompt` and `forbidden` rules only. It deliberately has no
# `allow` rule: an `allow` rule runs the matching command outside the sandbox
# and without a prompt, which would exempt it from the workspace-write sandbox
# in `codex.config.toml`. Everything not named here runs under the sandbox and
# approval policy as usual.
#
# Design rules, enforced where the policy is authored:
#   1. Every rule sets `decision`. A `prefix_rule` without one defaults to
#      `allow`.
#   2. Every rule carries inline `match` / `not_match` cases, and they must agree
#      with its pattern: Codex validates them when it loads the file, and one
#      failing example drops every project and user rule, the user's own
#      `~/.codex/rules/default.rules` included. `test_hooks.py` checks them.
#   3. Destructive operations are `forbidden`, not `prompt`. A prompt is a
#      decision the model can talk a user into; forbidden is not.
#
# Verify after editing (requires the Codex CLI):
#   codex execpolicy check --rules .codex/rules/template.rules -- git push --force

prefix_rule(
    pattern = ["python3", "Infrastructure/style/scripts/sync_tokens.py", "--write"],
    decision = "prompt",
    justification = "--write overwrites the three generated theme files; confirm first.",
    match = ["python3 Infrastructure/style/scripts/sync_tokens.py --write"],
    not_match = ["python3 Infrastructure/style/scripts/sync_tokens.py --check"],
)

# latexmk is prompted. Its `-e <code>` and `-r <rcfile>` options run
# arbitrary Perl, and `-pdflatex=<cmd>` (and the other engine-command options)
# replace the engine with any command. Those flags can follow any safe-looking
# prefix (`latexmk -pdf -e ...`), and prefix rules cannot exclude a later
# argument, so every latexmk build asks first.
prefix_rule(
    pattern = ["latexmk"],
    decision = "prompt",
    justification = "latexmk can run arbitrary Perl (-e, -r) or commands (-pdflatex=); confirm each build.",
    match = ["latexmk -pdf main.tex", "latexmk -C", "latexmk -pdf -e 'system(1)' main.tex"],
    not_match = ["pdflatex main.tex"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Publishing is outward-facing and requires explicit user approval.",
    match = ["git push", "git push origin main"],
    not_match = ["git status", "git fetch"],
)

# Force-push is forbidden in every flag position, not just immediately after
# `git push`. The Codex rules below cover the bare, remote-suffixed, and
# remote-plus-ref-suffixed forms, and a `+` refspec; a single rule catches only
# the first. Claude's `*` matches anywhere, so its rules cover a flag after any
# remote or ref (test_hooks.py checks every Codex example against them).
prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Force-push rewrites shared history. Coordinate history repair with the user instead.",
    match = ["git push --force", "git push -f", "git push --force-with-lease"],
    not_match = ["git push", "git push origin main"],
)

prefix_rule(
    pattern = ["git", "push", ["origin", "upstream"], ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Force-push rewrites shared history. Coordinate history repair with the user instead.",
    match = [
        "git push origin --force",
        "git push upstream -f",
        "git push origin --force-with-lease",
    ],
    not_match = ["git push origin main", "git push upstream HEAD"],
)

prefix_rule(
    pattern = ["git", "push", ["origin", "upstream"], ["main", "master", "HEAD"], ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Force-push rewrites shared history. Coordinate history repair with the user instead.",
    match = [
        "git push origin main --force",
        "git push upstream master -f",
        "git push origin HEAD --force-with-lease",
    ],
    not_match = ["git push origin main", "git push upstream HEAD"],
)

prefix_rule(
    pattern = ["git", "push", ["+main", "+master", "+HEAD"]],
    decision = "forbidden",
    justification = "Force-push rewrites shared history. Coordinate history repair with the user instead.",
    match = ["git push +main", "git push +HEAD"],
    not_match = ["git push", "git push main"],
)

prefix_rule(
    pattern = ["git", "push", ["origin", "upstream"], ["+main", "+master", "+HEAD"]],
    decision = "forbidden",
    justification = "Force-push rewrites shared history. Coordinate history repair with the user instead.",
    match = ["git push origin +main", "git push upstream +HEAD"],
    not_match = ["git push origin main", "git push upstream HEAD"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset destroys uncommitted work. Use a reversible operation after explicit review.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
    not_match = ["git reset --soft HEAD~1", "git status"],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-df", "-fx", "-xfd"]],
    decision = "forbidden",
    justification = "Forced clean irreversibly deletes untracked work, including un-committed drafts and data.",
    match = ["git clean -f", "git clean -fd", "git clean -xfd"],
    not_match = ["git clean -n", "git status"],
)

prefix_rule(
    pattern = ["git", ["restore", "checkout"], "--"],
    decision = "forbidden",
    justification = "Discarding working-tree changes needs a separately reviewed recovery plan.",
    match = ["git restore -- README.md", "git checkout -- README.md"],
    not_match = ["git restore --staged README.md", "git checkout feature-branch"],
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-fR"]],
    decision = "forbidden",
    justification = "Recursive forced deletion is not recoverable. Delete explicitly, one target at a time.",
    match = ["rm -rf build", "rm -fr output"],
    not_match = ["rm -f one.tmp", "rmdir empty-directory"],
)
